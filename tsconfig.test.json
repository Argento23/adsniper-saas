{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["node"],
    "outDir": "./.test-build",
    "rootDir": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "baseUrl": "."
  },
  "include": [
    "tests/**/*.test.ts",
    "lib/projects/**/*.ts",
    "lib/providers/**/*.ts",
    "lib/jobs/**/*.ts",
    "lib/creative-director/**/*.ts",
    "lib/api/**/*.ts",
    "lib/timeline-editor/**/*.ts",
    "lib/video/**/*.ts",
    "lib/fal.ts",
    "lib/replicate.ts"
  ],
  "exclude": ["node_modules", ".next", ".test-build", "app/**"]
}
